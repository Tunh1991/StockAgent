# Sao chép thành .env và điền khóa thật (không chia sẻ file .env)
GEMINI_API_KEY=your-key-from-google-ai-studio
GEMINI_MODEL=gemini-3.8-flash
WATCHLIST=HPG,SSI,FPT,VCB,TCB,MWG,VNM,DXG
SCAN_INTERVAL_MIN=4
GEMINI_MIN_INTERVAL_SEC=6
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=2
SECTORS=HPG:THEP,DXG:BDS,FPT:CHUNG,MWG:CHUNG,VNM:CHUNG
SKILLS=trend_template
